function lib.load(fd)
    function handle.setPixel(x,y,color24)
    function handle.getPixel(x,y)
    function handle.setPixels(x,y,w,framebuffer)
    function handle.getPixels(x,y,w,h)
    function handle.frame(x,y,w,h,writeonly)
        integer id
        recurse lib.load
    function handle.framectl(id)
        function frame.move(x,y)
        function frame.resize(w,h)
        function frame.free()
    function handle.sync()
    function handle.line(x1,y1,x2,y2)
    function handle.box(x,y,w,h,c,fill)
    function handle.filledBox(x,y,w,h,c)
    function handle.text(x,y,font,text)
    function handle.free()
    function handle.size()