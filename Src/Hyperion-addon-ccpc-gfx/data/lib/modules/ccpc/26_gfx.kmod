local iplt={}
for i=0, #plt do
    iplt[plt[i]]=i
end
local l1f,l1d,l2,ops={},{},{},0

local function findClosest(tbl, target)
    local closest = nil
    local smallestDiff = math.huge

    for k, _ in pairs(tbl) do
        if k==target then return k end
        local diff = math.abs(k - target)
        if diff < smallestDiff then
            smallestDiff = diff
            closest = k
        end
    end

    return closest
end

local function aprox(c24)
    ops = ops + 1

    if ops % 1024 == 0 then
        l1d = {}
        l1f = {}
    end

    if ops % 8192 == 0 then
        l2 = {}
    end

    if l2[c24] ~= nil then
        return l2[c24]
    end

    if l1d[c24] ~= nil then
        l1f[c24] = l1f[c24] + 1

        if l1f[c24] >= 16 then
            l2[c24] = l1d[c24]
            l1d[c24] = nil
            l1f[c24] = nil
            return l2[c24]
        end

        return l1d[c24]
    end

    local closestKey = findClosest(iplt, c24)
    if not closestKey then return nil end

    local value = iplt[closestKey]

    l1d[c24] = value
    l1f[c24] = 1

    return value
end

local function splitFramebufferToStrings(fb, w)
    local rows = {}

    for i = 1, #fb, w do
        local row_chars = {}
        for j = 0, w - 1 do
            local val = fb[i + j]
            if val ~= nil then
                table.insert(row_chars, string.char(aprox(val)))
            else
                break
            end
        end
        table.insert(rows, table.concat(row_chars))
    end

    return rows
end

local function creategfx(term, id)
    local active=false
    term.setGraphicsMode(2)
    for i=0, #plt do
        term.setPaletteColor(i,plt[i])
    end
    term.setGraphicsMode(false)
    term.setPaletteColor(0x1,    0xFFFFFF)
    term.setPaletteColor(0x2,    0xFF0000)
    term.setPaletteColor(0x4,    0x00FF00)
    term.setPaletteColor(0x8,    0x0000FF)
    term.setPaletteColor(0x10,   0x00FFFF)
    term.setPaletteColor(0x20,   0xFF00FF)
    term.setPaletteColor(0x40,   0xFFFF00)
    term.setPaletteColor(0x80,   0xFF6D00)
    term.setPaletteColor(0x100,  0x6DFF55)
    term.setPaletteColor(0x200,  0x24FFFF)
    term.setPaletteColor(0x400,  0x924900)
    term.setPaletteColor(0x800,  0x6D6D55)
    term.setPaletteColor(0x1000, 0xDBDBAA)
    term.setPaletteColor(0x2000, 0x6D00FF)
    term.setPaletteColor(0x4000, 0xB6FF00)
    term.setPaletteColor(0x8000, 0x000000)
    local handle={
        gplt=function()
            return setmetatable({},{__index=plt,__usermeta=false,__pairs=function() return pairs(plt) end})
        end,
        spixel=function(x,y,c)
            term.setPixel(x,y,aprox(c))
        end,
        gpixel=function(x,y)
            return term.getPixel()
        end,
        drawFB=function(x,y,fb,w)
            local f=splitFramebufferToStrings(fb,w)
            term.drawPixels(x,y,f)
        end,
        box=function(x,y,w,h,c,fill)
            c=aprox(c)
            if not fill then
                term.drawPixels(x,y,c,w,1)
                term.drawPixels(x,y,c,1,h)
                term.drawPixels(x+w-1,y,c,1,h)
                term.drawPixels(x,y+h-1,c,w,1)
            else
                term.drawPixels(x,y,c,w,h)
            end
        end,
        circle=function(xc,yc,r,c,fill)
            c=aprox(c)
            if not fill then
                local x = 0
                local y = r
                local d = 3 - 2 * r

                -- Helper function to plot all 8 symmetric points
                local function plot8Points(x, y)
                    term.setPixel(xc + x, yc + y, c)
                    term.setPixel(xc - x, yc + y, c)
                    term.setPixel(xc + x, yc - y, c)
                    term.setPixel(xc - x, yc - y, c)
                    term.setPixel(xc + y, yc + x, c)
                    term.setPixel(xc - y, yc + x, c)
                    term.setPixel(xc + y, yc - x, c)
                    term.setPixel(xc - y, yc - x, c)
                end

                plot8Points(x, y)

                while y >= x do
                    x = x + 1
                    if d > 0 then
                        y = y - 1
                        d = d + 4 * (x - y) + 10
                    else
                        d = d + 4 * x + 6
                    end
                    plot8Points(x, y)
                end
            else
                local x = 0
                local y = r
                local d = 3 - 2 * r

                -- Helper to fill rows using symmetry
                local function fillRows(x, y)
                    -- Width is (2 * coordinate) + 1 to include the center column
                    local strX = string.rep(string.char(c), 2 * x + 1)
                    local strY = string.rep(string.char(c), 2 * y + 1)
                    -- Draw the horizontal spans
                    term.drawPixels(xc - x, yc + y, {strX})
                    term.drawPixels(xc - x, yc - y, {strX})
                    term.drawPixels(xc - y, yc + x, {strY})
                    term.drawPixels(xc - y, yc - x, {strY})
                end

                fillRows(x, y)

                while y >= x do
                    x = x + 1
                    if d > 0 then
                        y = y - 1
                        d = d + 4 * (x - y) + 10
                    else
                        d = d + 4 * x + 6
                    end
                    fillRows(x, y)
                end
            end
        end,
        line=function(x1,y1,x2,y2,c)
            x1=math.floor(x1+0.5)
            y1=math.floor(y1+0.5)
            x2=math.floor(x2+0.5)
            y2=math.floor(y2+0.5)

            c=aprox(c)

            local w,h=term.getSize(2)

            local dx=math.abs(x2-x1)
            local dy=math.abs(y2-y1)

            local sx=x1<x2 and 1 or -1
            local sy=y1<y2 and 1 or -1

            local err=dx-dy

            while true do

                if 0<x1 and x1<=w and 0<y1 and y1<=h then
                    term.setPixel(x1,y1,c)
                end

                if x1==x2 and y1==y2 then
                    break
                end

                local e2=2*err

                if e2>-dy then
                    err=err-dy
                    x1=x1+sx
                end

                if e2<dx then
                    err=err+dx
                    y1=y1+sy
                end

            end
        end,
        setMode=function(state)
            if state then
                term.setGraphicsMode(2)
                for i=0, #plt do
                    term.setPaletteColor(i,plt[i])
                end
                active=true
            else
                term.setGraphicsMode(false)
                term.setPaletteColor(0x1,    0xFFFFFF)
                term.setPaletteColor(0x2,    0xFF0000)
                term.setPaletteColor(0x4,    0x00FF00)
                term.setPaletteColor(0x8,    0x0000FF)
                term.setPaletteColor(0x10,   0x00FFFF)
                term.setPaletteColor(0x20,   0xFF00FF)
                term.setPaletteColor(0x40,   0xFFFF00)
                term.setPaletteColor(0x80,   0xFF6D00)
                term.setPaletteColor(0x100,  0x6DFF55)
                term.setPaletteColor(0x200,  0x24FFFF)
                term.setPaletteColor(0x400,  0x924900)
                term.setPaletteColor(0x800,  0x6D6D55)
                term.setPaletteColor(0x1000, 0xDBDBAA)
                term.setPaletteColor(0x2000, 0x6D00FF)
                term.setPaletteColor(0x4000, 0xB6FF00)
                term.setPaletteColor(0x8000, 0x000000)
                active=false
            end
        end,
        getMode=function()
            return active
        end,
        size=function()
            return term.getSize(2)
        end,
        drawRun=function(y,x1,x2,c)
            term.drawPixels(x1,y,c,{string.rep(string.char(aprox(c)),x1-x2)})
        end
    }
    return handle
end

for id,obj in pairs(kernel.cct.term) do
    if obj.setGraphicsMode then
        kernel.cct.gfx[id]=creategfx(obj, id)
    end
end